# Copy to .env.local and configure the local PostgreSQL connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streambox?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run-openssl-rand-base64-32-to-generate"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local development storage; later phases can switch to s3 or cloudinary.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# Email delivery (password reset). Without these, emails are printed to the
# server console in development. Get a key at https://resend.com.
RESEND_API_KEY=""
EMAIL_FROM="StreamBox <no-reply@example.com>"

# Comma-separated emails of accounts that can review reports at /admin/reports.
ADMIN_EMAILS=""
